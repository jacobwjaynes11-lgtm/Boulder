{
  // Cloudflare settings for the Push the Boulder website.
  //   public/        the website
  //   src/worker.js  live coin data (/api/live) and Solana access (/api/rpc)
  // Needs a secret named RPC_URL (your Helius link) in the Cloudflare dashboard.
  "name": "boulder",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // One shared live tracker per coin
  "durable_objects": {
    "bindings": [{ "name": "LIVE", "class_name": "LiveCoin" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["LiveCoin"] }
  ]
}
